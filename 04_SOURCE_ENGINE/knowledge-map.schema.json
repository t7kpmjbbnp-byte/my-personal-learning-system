{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t7kpmjbbnp-byte.github.io/my-personal-learning-system/schemas/knowledge-map.schema.json",
  "title": "SÁCH TRỜI Knowledge Map",
  "description": "Stable mapping between source-backed Notion notes and universe-map nodes. Semantic relationships must be explicit and evidence-backed.",
  "type": "object",
  "required": [
    "map_id",
    "source_id",
    "version",
    "root_node_id",
    "groups",
    "nodes",
    "edges"
  ],
  "properties": {
    "map_id": {
      "type": "string",
      "pattern": "^[A-Z0-9-]+$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^SRC-[A-Z0-9-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "root_node_id": {
      "type": "string"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "group_id",
          "node_id",
          "title",
          "page_range"
        ],
        "properties": {
          "group_id": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "page_range": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "node_id",
          "note_id",
          "note_url",
          "node_type",
          "group_id",
          "page_locator",
          "evidence_type",
          "verification_status"
        ],
        "properties": {
          "node_id": {
            "type": "string"
          },
          "note_id": {
            "type": "string",
            "pattern": "^SRC-[A-Z0-9-]+-N[0-9]{2}$"
          },
          "note_url": {
            "type": "string",
            "format": "uri"
          },
          "node_type": {
            "enum": [
              "summary",
              "concept",
              "figure",
              "table",
              "question",
              "analysis"
            ]
          },
          "group_id": {
            "type": "string"
          },
          "page_locator": {
            "type": "string"
          },
          "evidence_type": {
            "enum": [
              "text",
              "image",
              "table",
              "diagram",
              "mixed"
            ]
          },
          "verification_status": {
            "enum": [
              "unreviewed",
              "in_progress",
              "verified",
              "rejected"
            ]
          },
          "parent_note_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "target_note_id",
                "relation_type"
              ],
              "properties": {
                "target_note_id": {
                  "type": "string"
                },
                "relation_type": {
                  "enum": [
                    "related",
                    "prerequisite",
                    "contrast",
                    "part_of",
                    "illustrates"
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from_node_id",
          "to_node_id",
          "edge_type"
        ],
        "properties": {
          "from_node_id": {
            "type": "string"
          },
          "to_node_id": {
            "type": "string"
          },
          "edge_type": {
            "enum": [
              "contains",
              "maps_to",
              "illustrates",
              "related",
              "prerequisite"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
